# Baked into production builds (Next.js loads this for `next build` / Vercel).
# Goodshuffle Pro → Activation → Public Browser Key (safe to expose in the browser).
NEXT_PUBLIC_GOODSHUFFLE_PUBLIC_WEBSITE_KEY=hjNKfY8rEFjzHjDOGwKGSq0BR97cWp

# Optional in production builds: sitemap, robots, and OG use `business.websiteUrl` in `lib/site-data.ts` (not this var).
NEXT_PUBLIC_SITE_URL=https://www.eventrentct.com

# Google Ads → Tools → Google tag (AW-…). Change here if Google Ads shows a different ID.
NEXT_PUBLIC_GOOGLE_ADS_AW_ID=AW-18131224378
# Quote request conversion → Google Ads event snippet send_to
NEXT_PUBLIC_GOOGLE_ADS_QUOTE_CONVERSION_SEND_TO=AW-18131224378/vVJkCM6U06UcELqO0sVD
