# Copy to `.env.local` for development. Production uses `.env.production` + Vercel overrides.

NEXT_PUBLIC_GOODSHUFFLE_PUBLIC_WEBSITE_KEY=
# Local / tooling only: `next dev` uses this when set. Production sitemap & canonicals use `business.websiteUrl` in `lib/site-data.ts`.
NEXT_PUBLIC_SITE_URL=https://www.eventrentct.com

# Optional: Google Search Console HTML tag verification (meta name="google-site-verification")
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: public URL of the Frame Tent Planner (Konva canvas) for embedding on /games — e.g. https://planner.example.com/planner
# NEXT_PUBLIC_TENT_LAYOUT_PLANNER_URL=

# Quote form emails (server-side; do not use NEXT_PUBLIC_ for API keys)
# Resend: https://resend.com — verify your domain, then set a "from" address on that domain.
RESEND_API_KEY=
QUOTE_EMAIL_FROM="Connecticut Party Rentals <quotes@example.com>"
# Inbox for quote notifications (defaults to the public business email in lib/site-data)
# QUOTE_NOTIFICATION_EMAIL=info@eventrentct.com

# Google Ads tag (gtag.js — see components/google-ads-gtag.tsx, lib/google-ads-id.ts)
# NEXT_PUBLIC_GOOGLE_ADS_AW_ID=AW-XXXXXXXXXX
# Leave empty (NEXT_PUBLIC_GOOGLE_ADS_AW_ID=) to disable only the Ads snippet; GTM still loads if set.
# Google Tag Manager (components/google-tag-manager.tsx) — e.g. GTM-XXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXX

# Quote conversion event: AW-…/label (preferred)
# NEXT_PUBLIC_GOOGLE_ADS_QUOTE_CONVERSION_SEND_TO=AW-XXXXXXXXXX/xxxxxxxxxxxxx
# Legacy alias (still read if QUOTE_… is unset)
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_SEND_TO=AW-XXXXXXXXXX/xxxxxxxxxxxxx

# If NEXT_PUBLIC_QUOTE_FORM_ACTION posts to a third-party form handler, set the redirect URL to your
# thank-you page so Google Ads can fire the conversion: …/contact/thank-you?quote=1
# NEXT_PUBLIC_QUOTE_THANK_YOU_URL=https://www.example.com/contact/thank-you?quote=1

# Optional overrides (see lib/goodshuffle-env.ts)
# NEXT_PUBLIC_GOODSHUFFLE_TABLE_CHAIR_CATEGORY=furniture-rentals
# NEXT_PUBLIC_GOODSHUFFLE_TENT_CANOPY_CATEGORY=tent-canopy-rentals
# Gallery item count (Goodshuffle default is 15 per page). Tent galleries default to 120 on one scroll.
# NEXT_PUBLIC_GOODSHUFFLE_GALLERY_SIZE=60
# NEXT_PUBLIC_GOODSHUFFLE_TENT_GALLERY_SIZE=120
